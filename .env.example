# Nexus AI Studio — web SaaS env (copy to .env.local for the WEB build only).
# The desktop build leaves these unset and runs exactly as before.

# Turn the web SaaS layer on (auth + gating). Unset/0 on desktop.
NEXT_PUBLIC_WEB_MODE=1

# Supabase (Project Settings -> API). Safe to expose (public anon key + URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Server-only secrets (Milestone 2: Stripe via a Supabase Edge Function) ----
# NEVER prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
