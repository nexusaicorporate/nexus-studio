# Nexus AI Studio — web SaaS env (copy to .env.local for the WEB build only).
# The desktop build leaves these unset and runs exactly as before.
#
# Stack: NextAuth + Prisma + Postgres + Stripe.  NO Supabase, NO Docker.

# Turn the web SaaS layer on (auth + gating). Unset/0 on desktop.
NEXT_PUBLIC_WEB_MODE=1

# Postgres connection for Prisma (same DB in dev/test and prod).
DATABASE_URL="postgresql://username:password@your-db-host:5432/db_name?sslmode=require"

# NextAuth (credentials auth). Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"    # prod: https://your-domain.com
NEXTAUTH_SECRET="your-generated-secret"

# ---- Stripe (billing). Server-only secrets — never prefix with NEXT_PUBLIC_. ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
