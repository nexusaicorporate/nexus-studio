{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus AI Studio",
  "version": "1.0.3",
  "identifier": "com.nexusaigear.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:static",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nexus AI Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/comfyui/**/*",
      "../modal/*.py"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Multi-provider prompt assistant + generative studio",
    "longDescription": "Nexus AI Studio \u2014 prompt, environment, ingredient and recipe libraries plus a generative studio for characters, images and video."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMzFBMDQ5RDUxQjUwOTAKUldTUVVCdlZTYUF4cXBMOUQ1MUZ3UmlDTFNsNnhPRUZNbFRnMHFLeVZYRjlST2gyRWVQZlRtUTIK"
    }
  }
}